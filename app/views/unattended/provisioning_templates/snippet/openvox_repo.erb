<%#
kind: snippet
name: openvox_repo
model: ProvisioningTemplate
snippet: true
description: |
  Fetches the package that deploys the OpenVox repository that can be
  used to install OpenVox from. It only performs the installation in case
  the enable-openvox8-repo parameter is set to true.
-%>
<%
  puppet_agent_repo_enabled = %w(enable-puppetlabs-repo enable-official-puppet8-repo enable-puppet8).any? { |param| host_param_true?(param) }
  openvox_agent_repo_enabled = host_param_true?('enable-openvox8-repo')
  os_family = @host.operatingsystem.family
-%>
<% if puppet_agent_repo_enabled && openvox_agent_repo_enabled -%>
<% if os_family == 'Windows' -%>
Write-Error "Cannot enable Puppet and OpenVox repositories at the same time"
exit 1
<% else -%>
echo "ERROR: Cannot enable Puppet and OpenVox repositories at the same time" >&2
exit 1
<% end -%>
<% end -%>
<%
http_proxy   = host_param('http-proxy') ? " --httpproxy #{host_param('http-proxy')}" : nil
http_port    = host_param('http-proxy-port') ? " --httpport #{host_param('http-proxy-port')}" : nil
proxy_uri    = host_param('http-proxy') ? "http://#{host_param('http-proxy')}:#{host_param('http-proxy-port')}" : nil
proxy_string = proxy_uri ? " -e https_proxy=#{proxy_uri}/" : ''
proxy_string_bits = proxy_uri ? " -ProxyUsage Override -ProxyList #{proxy_uri}" : ''
os_major  = @host.operatingsystem.major.to_i
os_minor  = @host.operatingsystem.minor
os_name   = @host.operatingsystem.name

if host_param_true?('enable-openvox8-repo')
  repo_name = 'openvox8-release'

  if os_family == 'Redhat'
    repo_host = 'yum.voxpupuli.org'
    if os_name == 'Fedora'
      repo_os = 'fedora'
    else
      repo_os = 'el'
    end
  elsif os_family == 'Suse'
    repo_host = 'yum.voxpupuli.org'
    repo_os = 'sles' # OpenVox repos only exist for SLES, not OpenSUSE
  elsif os_family == 'Debian'
    repo_host = 'apt.voxpupuli.org'
    if os_name == 'Ubuntu'
      repo_os = "ubuntu#{@host.operatingsystem.major}.#{os_minor}"
    else
      repo_os = "debian#{os_major}"
    end
  elsif os_family == 'Windows'
    repo_host = 'downloads.voxpupuli.org'
    repo_os = 'windows'
  end
-%>
<% if os_family == 'Redhat' || os_name == 'SLES' -%>
rpm -Uvh<%= http_proxy %><%= http_port %> https://<%= repo_host %>/<%= repo_name %>-<%= repo_os %>-<%= os_major %>.noarch.rpm
<% elsif os_family == 'Debian' -%>
apt-get update
apt-get -y install ca-certificates
wget -O /tmp/<%= repo_name %>-<%= repo_os %>.deb<%= proxy_string %> https://<%= repo_host %>/<%= repo_name %>-<%= repo_os %>.deb
dpkg -i /tmp/<%= repo_name %>-<%= repo_os %>.deb
<% elsif os_family == 'Windows' -%>
$openvox_agent_source = 'https://<%= repo_host %>/<%= repo_os %>/openvox-agent-<%= @host.architecture %>-latest.msi'
$openvox_agent_msi = "${env:TEMP}\openvox-agent-<%= @host.architecture %>.msi"
Write-Host "Downloading openvox-agent from ${$openvox_agent_source} to ${openvox_agent_msi}"
Start-BitsTransfer -Source "${openvox_agent_source}" -Destination "${openvox_agent_msi}"<%= proxy_string_bits %>
<% end -%>
<% end -%>
